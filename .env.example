# 复制为 .env 后按本机情况填写。.env 已被 .gitignore 排除。
# 已在进程里存在的同名环境变量优先，.env 不会覆盖 CI 注入的值。
# Windows 下路径用正斜杠；含空格的路径不要加引号，本文件按等号后的原样读取。

# ffmpeg 可执行文件，留 ffmpeg 表示走 PATH
AICUT_FFMPEG=ffmpeg

# 视频素材目录与叠加素材目录，可以分开
AICUT_VIDEOS=./materials/videos
AICUT_OVERLAYS=./materials/overlays

# 背景音乐。prepare 会自动分析它，不要求人工提供节拍 JSON
AICUT_BGM=./materials/bgm.mp4

# 可选兼容入口：prepare 产出的 runs/_cache/music.json 优先于此
# AICUT_MUSIC_JSON=./materials/music.json
